{#- Íconos SVG de trazo. Decorativos: el texto accesible va en el enlace o el botón. -#}
{%- macro icono(nombre, clase = "icono") -%}
<svg class="{{ clase }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- if nombre == "telefono" -%}
<path d="M5 4h3.2l1.8 4.6-2.3 1.5a11.5 11.5 0 0 0 6.2 6.2l1.5-2.3L20 15.8V19a2 2 0 0 1-2.1 2A17 17 0 0 1 3 6.1 2 2 0 0 1 5 4z"/>
{%- elif nombre == "correo" -%}
<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>
{%- elif nombre == "ubicacion" -%}
<path d="M12 21s-7-6.2-7-11.2a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.8" r="2.6"/>
{%- elif nombre == "facebook" -%}
<path d="M14.5 21v-7.5h2.8l.5-3.2h-3.3V8.4c0-.9.4-1.6 1.7-1.6H18V4a17 17 0 0 0-2.4-.2c-2.6 0-4.3 1.6-4.3 4.4v2.1H8.5v3.2h2.8V21"/>
{%- elif nombre == "instagram" -%}
<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="3.9"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/>
{%- elif nombre == "tiktok" -%}
<path d="M14 3.5v11.2a3.8 3.8 0 1 1-3.8-3.8"/><path d="M14 3.5a5 5 0 0 0 5 5"/>
{%- elif nombre == "flecha" -%}
<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
{%- elif nombre == "menu" -%}
<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>
{%- elif nombre == "cerrar" -%}
<path d="M6 6l12 12"/><path d="M18 6 6 18"/>
{%- elif nombre == "externo" -%}
<path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
{%- endif -%}
</svg>
{%- endmacro -%}
